generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  role         Role          @default(USER)
  name         String
  email        String        @unique
  password     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  reservations Reservation[]
}

enum Role {
  ADMIN
  USER
}

model Movie {
  id          String     @id @default(uuid()) @db.Uuid
  title       String
  name        String     @unique
  description String
  poster      String?
  duration    Int        // duration in minutes
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  showTimes   ShowTime[]
}

model ShowTime {
  id            String     @id @default(uuid()) @db.Uuid
  basePrice     Decimal    @db.Decimal(10, 2)
  baseCurrency  String     @default("EGP")
  showTimeStart DateTime
  showTimeEnd   DateTime
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  movieId       String     @db.Uuid
  movie         Movie      @relation(fields: [movieId], references: [id])

  hallId        String     @db.Uuid
  hall          Hall       @relation(fields: [hallId], references: [id])

  reservations  Reservation[]

  @@index([movieId])
  @@index([hallId])
  @@index([showTimeStart])
}

model Hall {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  description String?
  capacity    Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  showTimes   ShowTime[]
  sections    Section[]
}

model Section {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  additionPrice  Decimal  @db.Decimal(10, 2)
  rows           Int
  columns        Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  hallId         String   @db.Uuid
  hall           Hall     @relation(fields: [hallId], references: [id])

  seats          Seat[]

  @@index([hallId])
}

model Seat {
  id          String   @id @default(uuid()) @db.Uuid
  number      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sectionId   String   @db.Uuid
  section     Section   @relation(fields: [sectionId], references: [id])

  reservations ReservationSeat[]

  @@unique([sectionId, number])
}

model Reservation {
  id          String             @id @default(uuid()) @db.Uuid
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  userId      String             @db.Uuid
  user        User               @relation(fields: [userId], references: [id])

  showTimeId  String             @db.Uuid
  showTime    ShowTime           @relation(fields: [showTimeId], references: [id])

  seats       ReservationSeat[]
}

model ReservationSeat {
  id             String      @id @default(uuid()) @db.Uuid

  reservationId  String      @db.Uuid
  reservation    Reservation @relation(fields: [reservationId], references: [id])

  seatId         String      @db.Uuid
  seat           Seat        @relation(fields: [seatId], references: [id])

  price          Decimal     @db.Decimal(10, 2)

  @@unique([reservationId, seatId])
}